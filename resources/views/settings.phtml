<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\I18N;

/**
 * @var string $title
 * @var string $description
 * @var array<int,array<string,mixed>> $languages
 * @var array<int,array<string,mixed>> $providers
 * @var string $custom_data_folder
 * @var string $custom_csv_documentation_url
 * @var string $custom_csv_example_url
 * @var list<array{name:string,title:string}> $active_legacy_modules
 */
?>

<?= view('components/breadcrumbs', [
    'links' => [route(ControlPanel::class) => I18N::translate('Control panel'), $title],
]) ?>

<h1><?= e($title) ?></h1>
<p><?= e($description) ?></p>

<?php if ($active_legacy_modules !== []): ?>
    <div class="alert alert-danger" role="alert">
        <h2 class="h5 alert-heading"><?= I18N::translate('Superseded modules are active') ?></h2>
        <p>
            <?= I18N::translate('The following older modules are still active and provide data already included in this module:') ?>
        </p>
        <ul>
            <?php foreach ($active_legacy_modules as $legacy_module): ?>
                <li>
                    <?= e($legacy_module['title']) ?>
                    (<code><?= e($legacy_module['name']) ?></code>)
                </li>
            <?php endforeach ?>
        </ul>
        <p class="mb-0 fw-bold">
            <?= I18N::translate('Disable these modules and delete their folders from modules_v4. Do not run them in parallel with this module.') ?>
        </p>
    </div>
<?php endif ?>

<div class="alert alert-info">
    <h2 class="h5"><?= I18N::translate('Custom CSV files') ?></h2>
    <p class="mb-2">
        <?= I18N::translate('Store custom CSV files in this persistent data directory. Files in this directory override bundled CSV files with the same name.') ?>
    </p>
    <code class="d-block mb-2"><?= e($custom_data_folder) ?></code>
    <p class="small mb-0">
        <?= I18N::translate('CSV columns: start date; end date; event text; source link; optional category') ?>
    </p>
    <p class="small mb-0">
        <?= I18N::translate('New custom files require FORMAT, TOPIC, and LANGUAGE metadata. REGION optionally describes the geographical region in the language of the file.') ?>
    </p>
    <p class="small mt-2 mb-0">
        <a href="<?= e($custom_csv_documentation_url) ?>" target="_blank" rel="noopener noreferrer">
            <?= I18N::translate('Custom CSV file format') ?>
        </a>
        ·
        <a href="<?= e($custom_csv_example_url) ?>" target="_blank" rel="noopener noreferrer">
            <?= I18N::translate('Download example CSV file') ?>
        </a>
    </p>
</div>

<form method="post" class="mb-5">
    <?= csrf_field() ?>

    <h2 class="h3 mt-4"><?= I18N::translate('1. Selection by language') ?></h2>

    <fieldset class="form-group mb-4">
        <div class="row">
            <legend class="col-form-label col-sm-3 wt-page-options-label">
                <?= I18N::translate('Event languages') ?>
            </legend>
            <div class="col-sm-9 wt-page-options-value">
                <div class="small text-muted mb-2">
                    <?= I18N::translate('Select which data sources are used for each event language.') ?>
                </div>

                <?php foreach ($languages as $language): ?>
                    <div class="mb-3">
                        <div class="fw-bold mb-1">
                            <?= e($language['label']) ?>
                        </div>
                        <div class="row">
                            <?php foreach ($language['sources'] as $source): ?>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            name="<?= e($source['form_key']) ?>"
                                            id="<?= e($source['form_key']) ?>"
                                            value="1"
                                            <?= $source['enabled'] ? 'checked' : '' ?>
                                        >
                                        <label class="form-check-label" for="<?= e($source['form_key']) ?>">
                                            <?= e($source['provider_title']) ?>
                                        </label>
                                    </div>
                                </div>
                            <?php endforeach ?>
                        </div>
                    </div>
                <?php endforeach ?>
            </div>
        </div>
    </fieldset>

    <h2 class="h3 mt-5"><?= I18N::translate('2. Selection by individual data sources') ?></h2>

    <?php foreach ($providers as $provider): ?>
        <fieldset class="form-group mb-4">
            <div class="row">
                <legend class="col-form-label col-sm-3 wt-page-options-label">
                    <?= e($provider['title']) ?>
                </legend>
                <div class="col-sm-9 wt-page-options-value">
                    <div class="form-check mb-2">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            name="<?= e($provider['form_key']) ?>"
                            id="<?= e($provider['form_key']) ?>"
                            value="1"
                            <?= $provider['enabled'] ? 'checked' : '' ?>
                        >
                        <label class="form-check-label" for="<?= e($provider['form_key']) ?>">
                            <?= I18N::translate('Use this data source') ?>
                        </label>
                    </div>

                    <div class="small text-muted mb-2">
                        <?= e($provider['description']) ?>
                    </div>
                    <div class="small text-muted mb-2">
                        <?= I18N::translate('Source') ?>:
                        <?php if ($provider['source_url'] !== ''): ?>
                            <a href="<?= e($provider['source_url']) ?>" target="_blank" rel="noopener noreferrer">
                                <?= e($provider['source_title']) ?>
                            </a>
                        <?php else: ?>
                            <?= e($provider['source_title']) ?>
                        <?php endif ?>
                    </div>
                    <?php if ($provider['source_status'] !== ''): ?>
                        <div class="small text-muted mb-2">
                            <?= e($provider['source_status']) ?>
                        </div>
                    <?php endif ?>
                    <div class="small text-muted mb-2">
                        <?= I18N::translate('Event language') ?>:
                        <?= e($provider['languages']) ?>
                    </div>

                    <?php if ($provider['types'] !== []): ?>
                        <div class="row">
                            <?php foreach ($provider['types'] as $type): ?>
                                <div class="col-sm-6 col-lg-4">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="checkbox"
                                            name="<?= e($type['form_key']) ?>"
                                            id="<?= e($type['form_key']) ?>"
                                            value="1"
                                            <?= $type['enabled'] ? 'checked' : '' ?>
                                        >
                                        <label class="form-check-label" for="<?= e($type['form_key']) ?>">
                                            <?php if ($type['custom']): ?>
                                                <span class="badge text-bg-info me-1">
                                                    <?= I18N::translate('User-specific') ?>
                                                </span>
                                            <?php endif ?>
                                            <?php if ($type['overrides_bundled']): ?>
                                                <span
                                                    class="text-warning me-1"
                                                    title="<?= e(I18N::translate('Overrides a bundled file')) ?>"
                                                    aria-label="<?= e(I18N::translate('Overrides a bundled file')) ?>"
                                                >
                                                    <i class="fa-solid fa-code-compare" aria-hidden="true"></i>
                                                </span>
                                            <?php endif ?>
                                            <?= e($type['label']) ?>
                                            <?php if ($type['language'] !== ''): ?>
                                                <span class="text-muted">
                                                    (<?= e($type['language']) ?>)
                                                </span>
                                            <?php endif ?>
                                        </label>
                                    </div>
                                </div>
                            <?php endforeach ?>
                        </div>
                    <?php endif ?>
                </div>
            </div>
        </fieldset>
    <?php endforeach ?>

    <button type="submit" class="btn btn-primary">
        <?= view('icons/save') ?>
        <?= I18N::translate('save') ?>
    </button>
</form>
