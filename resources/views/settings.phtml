        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const tableBody = document.querySelector('#custom-csv-rows tbody');
                const template = document.querySelector('#custom-csv-row-template');
                const addButton = document.querySelector('#add-custom-csv-row');
                let nextRowIndex = <?= count($editor_rows) ?>;
                if (!tableBody || !template || !addButton) {
                    return;
                }

                const bindRemoveButtons = () => {
                    tableBody.querySelectorAll('.js-remove-csv-row').forEach((button) => {
                        button.onclick = () => button.closest('tr')?.remove();
                    });
                };

                addButton.addEventListener('click', () => {
                    const row = template.content.cloneNode(true);
                    row.querySelectorAll('input[data-name]').forEach((input) => {
                        input.name = `rows[${nextRowIndex}][${input.dataset.name}]`;
                    });
                    nextRowIndex += 1;
                    tableBody.appendChild(row);
                    bindRemoveButtons();
                });
                bindRemoveButtons();
            });
        </script>
