use Hartenthaler\WebtreesModules\History\HhHistoricEvents\Internationalization\MoreI18N;

/**
 * @var string $title
 * @var string $description
 * @var array<int,array<string,mixed>> $languages
 * @var array<int,array<string,mixed>> $providers
 * @var list<array{region:string,collections:list<array{reference:string,label:string}>}> $regions
 * @var bool $show_event_ages
 * @var string $custom_data_folder
 * @var string $custom_csv_documentation_url
 * @var string $custom_csv_example_url
 * @var list<array{name:string,title:string}> $active_legacy_modules
 * @var list<array{filename:string,topic:string,language:string,region:string,edit_url:string}> $custom_csv_files
 * @var array{filename:string,metadata:array<string,string>,rows:list<array<string,string>>}|null $selected_custom_csv
 */

$custom_csv_language_options = ['en' => 'English (en)'];
foreach (I18N::activeLocales() as $locale) {
    $custom_csv_language_options[$locale->languageTag()] = $locale->endonym() . ' (' . $locale->languageTag() . ')';
}
ksort($custom_csv_language_options);
?>

<?= view('components/breadcrumbs', [
    'links' => [route(ControlPanel::class) => MoreI18N::xlate('Control panel'), $title],
]) ?>

<h1><?= e($title) ?></h1>
<p><?= e($description) ?></p>

<nav class="nav nav-pills gap-2 mb-4" aria-label="<?= e(I18N::translate('Settings navigation')) ?>">
    <a class="nav-link" href="#configuration"><?= I18N::translate('Configuration') ?></a>
    <a class="nav-link" href="#custom-csv"><?= I18N::translate('Custom CSV files') ?></a>
    <a class="nav-link" href="#event-identities"><?= I18N::translate('Event identities and equivalences') ?></a>
</nav>

<?php if ($active_legacy_modules !== []): ?>
    <div class="alert alert-danger" role="alert">
        <h2 class="h5 alert-heading"><?= I18N::translate('Superseded modules are active') ?></h2>
        <p>
            <?= I18N::translate('The following older modules are still active and provide data already included in this module:') ?>
        </p>
        <ul>
            <?php foreach ($active_legacy_modules as $legacy_module): ?>
                <li>
                    <?= e($legacy_module['title']) ?>
                    (<code><?= e($legacy_module['name']) ?></code>)
                </li>
            <?php endforeach ?>
        </ul>
        <p class="mb-0 fw-bold">
            <?= I18N::translate('Disable these modules and delete their folders from modules_v4. Do not run them in parallel with this module.') ?>
        </p>
    </div>
<?php endif ?>

